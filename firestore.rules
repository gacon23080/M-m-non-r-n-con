rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'gacon23080@gmail.com' && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'google.com')) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Characters
    match /characters/{characterId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if true;
    }

    // Community Posts
    match /communityPosts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAdmin() || (isSignedIn() && (resource.data.authorId == request.auth.uid || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'likedBy', 'repliesCount'])));
      allow delete: if isAdmin() || (isSignedIn() && resource.data.authorId == request.auth.uid);

      match /replies/{replyId} {
        allow read: if true;
        allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
        allow delete: if isAdmin() || (isSignedIn() && resource.data.authorId == request.auth.uid);
      }
    }

    // Anonymous Messages
    match /anonymousMessages/{messageId} {
      allow read: if true;
      allow create: if request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 2000;
      allow update, delete: if true;
    }

    // User Profiles
    match /profiles/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Admins
    match /admins/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Votes
    match /votes/{voteId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Music Tracks
    match /musicTracks/{trackId} {
      allow read: if true;
      allow write: if true;
    }

    // System Settings (Teacher atelier, categories, tags)
    match /systemSettings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Conversations
    match /conversations/{conversationId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // Friend Requests
    match /friendRequests/{requestId} {
      allow read, write: if true;
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // Game Results
    match /gameResults/{resultId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Live Chat Messages
    match /liveChatMessages/{msgId} {
      allow read: if true;
      allow create: if true;
      allow update: if isAdmin();
      allow delete: if true;
    }

    // Game Sessions
    match /gameSessions/{sessionId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }
  }
}
